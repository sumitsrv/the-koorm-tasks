# Python
__pycache__/
*.py[cod]

# Virtualenv
.venv/

# Training artifacts — large, regenerable via train.py / export.py
outputs/
*.safetensors
*.gguf
*.bin

# Unsloth compile cache (generated)
unsloth_compiled_cache/

# repair.py output/backup — regenerate with `python src/repair.py`
data/distilled/*.repaired.jsonl
data/distilled/*.v1.bak

# Generated training data — uncomment to keep it out of git.
# It's small (a few MB) but takes hours to regenerate, so it's tracked by default.
# See data/README.md for what lives where.
# data/train.jsonl
# data/gold/*.jsonl
# data/distilled/*.jsonl
# data/distilled/descriptions.json

# Editors / IDEs
.idea/
.vscode/

# pyenv local version pin (machine-specific; README's setup uses `py -3.12` instead)
.python-version